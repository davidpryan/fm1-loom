# SEQ's third page, Gen: each generator written into the pattern from the pattern as it was, undone in one go; a kit's
# sound shown alone (GRIDS: kick, snare, hat); turning back gets the pattern back; another page then Gen again starts
# from the pattern as it is
wait 300
expect trk 1
hits 1 1 3 ..x.............
tap SEQ
turn SELECT 2
wait 50
expect page Gen
shot gen_kit.png
# euclid's four hits on the kick, the hat left
tapkey w0
wait 50
expect note 1 1 1 1
expect note 1 1 5 1
expect note 1 1 13 1
expect note 1 1 2 0
expect note 1 1 3 3
shot gen_euclid.png
# hits 0: back to the base (the hat alone)
turn K2 -4
expect note 1 1 1 0
expect note 1 1 3 3
turn K2 4
expect note 1 1 1 1
# undo: the pattern before the page's first turn
press HOME
tap REC
release HOME
expect note 1 1 1 0
expect note 1 1 3 3
# grids on the kit: the corner of the map at full density writes its kick on step 1
tapkey w1
turn K2 -50
turn K3 -50
turn K4 50
wait 50
expect note 1 1 1 1
shot gen_grids.png
# the turing machine, the walk and mutate on a synth: notes in C major
turn ALGO 1
expect trk 2
wait 50
expect page Gen
notes 2 1 1 1 100 C4
notes 2 1 9 1 100 G4
tapkey w0
wait 50
expect note 2 1 1 60
expect note 2 1 5 60
expect note 2 1 9 67
expect note 2 1 13 67
tapkey w2
wait 50
shot gen_turing.png
tapkey w3
turn K2 30
wait 50
shot gen_walk.png
tapkey w4
wait 50
expect note 2 1 1 60
expect note 2 1 9 67
turn K2 6
wait 50
shot gen_mutate.png
turn PRESET 1
wait 50
shot gen_roll.png
# hold SEQ: the help card
press SEQ
wait 1200
shot gen_card.png
release SEQ
